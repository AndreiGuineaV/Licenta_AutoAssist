## Configuration Template for AutoAssist
# Copy this file to 'local.properties' and fill in your local environment paths and API keys.
# 'local.properties' is gitignored and will never be committed to version control.

# Android SDK Path
# Windows example: sdk.dir=C\:\\Users\\<YourUsername>\\AppData\\Local\\Android\\Sdk
# macOS example:   sdk.dir=/Users/<YourUsername>/Library/Android/sdk
# Linux example:   sdk.dir=/home/<YourUsername>/Android/Sdk
sdk.dir=

# Google Gemini AI Studio API Key (Required for AI Diagnostic features)
# Obtain a free key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
